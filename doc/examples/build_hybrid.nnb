net "Convolutions, then a Transformer"
# CIFAR-10, 3×32×32. Convolutions find local patterns cheaply; the Transformer then
# relates the 64 positions to each other.
let d = 128

def unit(c) {                      # convolution -> BatchNorm -> ReLU, size kept
  a conv c 3x3 none nobias
  b bn
  r relu
}

1 input
2 unit(64)                         # (64, 32, 32)
3 unit(64)
4 maxpool 2x2                      # (64, 16, 16)
5 unit(d)                          # (128, 16, 16)
6 conv d 2x2 stride 2 valid none   # (128, 8, 8): each 2×2 patch one position
7 to_tokens patches                # (64, 128): 64 tokens of 128 values
8 cls_pos                          # (65, 128): class token first, positions added
9 repeat 4 {                       # four pre-norm encoder blocks
    a ln
    b attention heads 4 drop 0.1
    c add <- in, b
    e ln
    f dense d * 2 gelu
    g dense d none
    h add <- c, g
  }
10 ln
11 token_pool cls                  # (128): the class token's vector
12 output
